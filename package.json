{
	"name": "typing-practice",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"format": "prettier --write .",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"commit": "cz"
	},
	"config": {
		"commitizen": {
			"path": "cz-git"
		}
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@tailwindcss/vite": "^4.1.18",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"commitizen": "^4.3.2",
		"cz-git": "^1.13.1",
		"dexie": "^4.3.0",
		"dexie-react-hooks": "^4.2.0",
		"husky": "^9.1.7",
		"prettier": "^3.8.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4.1.18",
		"typescript": "~5.9.3",
		"vite": "^7.2.4"
	},
	"dependencies": {
		"react": "^19.2.3",
		"react-dom": "^19.2.3"
	}
}
