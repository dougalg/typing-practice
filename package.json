{
	"name": "typing-practice",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"format": "prettier --write .",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"commit": "cz",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"config": {
		"commitizen": {
			"path": "cz-git"
		}
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@tailwindcss/vite": "^4.3.3",
