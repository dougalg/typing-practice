{
	"name": "typing-practice",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"format": "prettier --write .",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"prepare": "husky",
