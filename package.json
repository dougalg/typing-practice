		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"axe-core": "^4.13.0",
		"commitizen": "^4.3.2",
		"cz-git": "^1.14.0",
		"dexie": "^4.4.6",
		"dexie-react-hooks": "^4.4.0",
		"fake-indexeddb": "^6.2.5",
		"husky": "^9.1.7",
		"jsdom": "^30.1.0",
		"prettier": "^3.9.8",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
