		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"axe-core": "^4.13.0",
		"commitizen": "^4.3.2",
		"cz-git": "^1.14.0",
		"dexie": "^4.4.6",
		"dexie-react-hooks": "^4.4.0",
		"fake-indexeddb": "^6.2.5",
